<Project>
  <!--
    <Version> is GUARDED: an unconditional value silently wins over `dotnet build -p:Version=x.y.z`,
    stamping 1.0.0 into the assembly while the package carries the real number. CI passes -p:Version on
    build AND pack. AssemblyVersion/FileVersion are deliberately not set — the SDK derives them.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <RepositoryUrl>https://github.com/modelingevolution/seeedstudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
